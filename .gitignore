# dependencies & build output
node_modules/
dist/
src-tauri/target/
src-tauri/gen/

# distributable binaries belong in GitHub Releases, never in git history
*.dmg
*.exe
*.msi
*.app/

# runtime noise
*.log
.DS_Store

# Demo working files. Only the optimised GIF that the README points at belongs in git —
# the raw screen recording is 15 MB and would sit in history forever.
docs/video/*.mp4
docs/video/poster.png
