{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Kapabilitas untuk window utama",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-dragging",
    "core:event:default",
    "dialog:allow-save",
    "dialog:allow-message",
    "global-shortcut:default"
  ]
}
